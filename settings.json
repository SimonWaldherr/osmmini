{
  "map_display": {
    "renderer": "micromap",
    "micromap": {
      "quality": "sharp",
      "view": "perspective",
      "buildings": "auto",
      "sky": "auto",
      "interaction": "full"
    }
  },
  "use_case": "private",
  "routing": {
    "engine": "astar",
    "objective": "distance",
    "pro": false,
    "weights": {
      "left_turn": 0,
      "right_turn": 0,
      "u_turn": 0,
      "crossing": 0,
      "max_speed_kph": 0,
      "vehicle_height_m": 0,
      "vehicle_weight_t": 0
    }
  },
  "tiles": {
    "cache_dir": "tiles-cache",
    "upstream": "",
    "user_agent": "osmmini-routerd/1.0 (offline routing)",
    "map_type": "vector",
    "style_url": "/static/styles/tinytiles-minimal.json",
    "attribution": "© OpenStreetMap contributors",
    "max_zoom": 14
  },
  "ai": {},
  "save_poi_cache": true,
  "default_highway_speeds": {
    "motorway": 150
  }
}